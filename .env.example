# Ecommerce V0/V1 configuration reference. NOT loaded automatically by run_ecommerce.
# No actual key belongs in this file, Git, the browser, or workspace state.
# Store qwen-api-key in the server process environment or Windows user environment.
# qwen-api-key=YOUR_PRIVATE_KEY

# Enforced by devtools.run_ecommerce (offline unless --qwen is explicit):
HOST=127.0.0.1
ECOMMERCE_RESTRICTED=true
# Default v0 uses the single AnalystAgent; explicitly set v1 in the process environment
# for the LangGraph Qwen team; --qwen and the existing ledger are required for new runs.
ECOMMERCE_ANALYSIS_ORCHESTRATOR=v0
WORKSPACE_BACKEND=local
DISABLE_DATABASE=false
DISABLE_DATA_CONNECTORS=true
DISABLE_CUSTOM_MODELS=true
DISABLE_DISPLAY_KEYS=true
PYTHON_DOTENV_DISABLED=1

# --qwen maps the private qwen-api-key to QWEN_API_KEY only in server memory.
# Fixed model: qwen-flash
# Fixed endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
# Runtime directory: <project>/.local/runtime
# Cumulative budget ledger: <project>/.local/verification/qwen-usage.json
# Total budget: CNY 10; never delete or reset an existing ledger.
